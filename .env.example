# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# ============================================================================
# CORS Configuration
# ============================================================================
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# File Upload Configuration
# ============================================================================
# Maximum file size in bytes (10MB = 10485760 bytes)
MAX_FILE_SIZE=10485760
# Comma-separated list of allowed file extensions
ALLOWED_EXTENSIONS=jpg,jpeg,png

# ============================================================================
# Model Configuration
# ============================================================================
# Real-ESRGAN model name
MODEL_NAME=RealESRGAN_x4plus
# Upscaling scale factor (2x or 4x)
MODEL_SCALE=4
# Path to model weights directory
MODEL_PATH=weights
# Tile size for processing large images (0 = no tiling, 512 = recommended for 8GB VRAM)
# Set to 0 for faster processing if you have enough VRAM
TILE_SIZE=0
# Use half precision (FP16) for GPU memory optimization (true/false)
# Only works with CUDA, automatically disabled on CPU
HALF_PRECISION=true

# ============================================================================
# Output Configuration
# ============================================================================
# Default target resolution for upscaling (2k, 4k)
DEFAULT_TARGET_RESOLUTION=2k
# Comma-separated list of supported resolutions
SUPPORTED_RESOLUTIONS=2k,4k
# Output image format (jpeg, png)
# JPEG is 5-10x faster than PNG with minimal quality loss at 85% quality
OUTPUT_FORMAT=jpeg
# Output quality for JPEG (0-100, recommended: 85)
OUTPUT_QUALITY=85

# ============================================================================
# Smart Auto-Detection Configuration
# ============================================================================
# These thresholds control the image analysis algorithms for smart auto-detection
# Adjust these values to fine-tune detection sensitivity

# --- Grayscale Detection ---
# Tolerance for comparing RGB channels (default: 1e-5)
# Lower values = stricter grayscale detection
# Higher values = more lenient (may detect near-grayscale as grayscale)
SMART_GRAYSCALE_TOLERANCE=1e-5

# Confidence threshold for suggesting colorization mode (0.0-1.0, default: 0.9)
# Only suggest colorization if grayscale confidence > this threshold
SMART_GRAYSCALE_CONFIDENCE_THRESHOLD=0.9

# --- White Mask Detection ---
# RGB threshold for white pixels (0-255, default: 240)
# Pixels with all RGB values >= this threshold are considered white
# Lower values = more pixels detected as white
# Higher values = only pure white pixels detected
SMART_WHITE_MASK_THRESHOLD=240

# Percentage threshold for white mask detection (0.0-1.0, default: 0.30)
# Suggest inpainting if white pixels > this percentage of total image
# Example: 0.30 = 30% of image must be white to trigger inpainting
SMART_WHITE_MASK_PERCENTAGE=0.30

# --- Low Resolution Detection ---
# Minimum dimension threshold in pixels (default: 512)
# Images with width OR height < this value are considered low resolution
# Suggest upscaling if either dimension is below threshold
SMART_LOW_RES_THRESHOLD=512

# --- Blur Detection ---
# Laplacian variance threshold for blur detection (default: 100.0)
# Images with variance < this value are considered blurry
# Lower values = stricter blur detection (only very blurry images)
# Higher values = more lenient (detect slight blur)
SMART_BLUR_VARIANCE_THRESHOLD=100.0

# --- Performance Optimization ---
# Maximum image size for analysis (default: 1024)
# Large images are resized to this size before analysis for faster processing
# This ensures analysis completes in <200ms even for 4K images
# Does not affect final processing quality, only analysis speed
SMART_ANALYSIS_MAX_SIZE=1024

# ============================================================================
# CodeFormer Face Enhancement Configuration
# ============================================================================
# CodeFormer model path
CODEFORMER_MODEL_PATH=weights/CodeFormer/codeformer.pth
# Default fidelity weight (0.0-1.0, default: 0.5)
# Lower values = more enhancement, higher values = preserve original face
CODEFORMER_DEFAULT_FIDELITY=0.5
# Background enhancement strength (0.0-1.0, default: 1.0)
CODEFORMER_BG_UPSAMPLER=1.0
# Face upscaling factor (1, 2, 4, default: 2)
CODEFORMER_FACE_UPSAMPLE=2

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# Enable structured logging (true/false)
STRUCTURED_LOGGING=true

# ============================================================================
# Sprint 2 — AWS Cognito Authentication
# ============================================================================
# Region where the User Pool lives
COGNITO_REGION=ap-southeast-1
# User Pool ID (from AWS Console → Cognito → Overview)
COGNITO_USER_POOL_ID=ap-southeast-1_yMHGGcfAO
# App client ID (SPA client, no secret)
COGNITO_CLIENT_ID=76irjqk5s74o350mondlk86vj6
# Which token to verify: "access" (default) or "id"
# FE currently sends the id_token — use "id" if that's the case
COGNITO_TOKEN_USE=access
