# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# File Upload Configuration
# ============================================================================
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png

# ============================================================================
# Model Configuration
# ============================================================================
MODEL_NAME=RealESRGAN_x4plus
MODEL_SCALE=4
MODEL_PATH=weights
# ⚡ OPTIMIZED: Disable tiling for 1024x1024 images (RTX 4060 8GB has enough VRAM)
# tile=0 is faster than tile=512 (no overhead from splitting/merging tiles)
# For larger images, may need to revert to tile=512 to avoid CUDA OOM
TILE_SIZE=0
# Half precision (FP16) for GPU memory optimization
# Only works with CUDA, automatically disabled on CPU
HALF_PRECISION=true

# ============================================================================
# Output Configuration
# ============================================================================
DEFAULT_TARGET_RESOLUTION=2k
SUPPORTED_RESOLUTIONS=2k,4k
# ⚡ OPTIMIZED: Changed to JPEG for faster encoding (5-10x faster than PNG)
# JPEG quality 85 provides good balance between quality and speed
OUTPUT_FORMAT=jpeg
OUTPUT_QUALITY=85

# ============================================================================
# Smart Auto-Detection Configuration
# ============================================================================
# These thresholds control the image analysis algorithms for smart auto-detection
# Adjust these values to fine-tune detection sensitivity

# --- Grayscale Detection ---
# Tolerance for comparing RGB channels (default: 1e-5)
# Lower values = stricter grayscale detection
# Higher values = more lenient (may detect near-grayscale as grayscale)
SMART_GRAYSCALE_TOLERANCE=1e-5

# Confidence threshold for suggesting colorization mode (0.0-1.0, default: 0.9)
# Only suggest colorization if grayscale confidence > this threshold
SMART_GRAYSCALE_CONFIDENCE_THRESHOLD=0.9

# --- White Mask Detection ---
# RGB threshold for white pixels (0-255, default: 240)
# Pixels with all RGB values >= this threshold are considered white
# Lower values = more pixels detected as white
# Higher values = only pure white pixels detected
SMART_WHITE_MASK_THRESHOLD=240

# Percentage threshold for white mask detection (0.0-1.0, default: 0.30)
# Suggest inpainting if white pixels > this percentage of total image
# Example: 0.30 = 30% of image must be white to trigger inpainting
SMART_WHITE_MASK_PERCENTAGE=0.30

# --- Low Resolution Detection ---
# Minimum dimension threshold in pixels (default: 512)
# Images with width OR height < this value are considered low resolution
# Suggest upscaling if either dimension is below threshold
SMART_LOW_RES_THRESHOLD=512

# --- Blur Detection ---
# Laplacian variance threshold for blur detection (default: 100.0)
# Images with variance < this value are considered blurry
# Lower values = stricter blur detection (only very blurry images)
# Higher values = more lenient (detect slight blur)
SMART_BLUR_VARIANCE_THRESHOLD=100.0

# --- Performance Optimization ---
# Maximum image size for analysis (default: 1024)
# Large images are resized to this size before analysis for faster processing
# This ensures analysis completes in <200ms even for 4K images
# Does not affect final processing quality, only analysis speed
SMART_ANALYSIS_MAX_SIZE=1024
